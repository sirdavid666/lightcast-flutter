#!/usr/bin/env sh
set -eu
# This must match the Gradle version required by AGP 8.5.2.
GRADLE_VERSION="8.7"
CACHE_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/lightcast-distributions"
GRADLE_HOME="$CACHE_DIR/gradle-$GRADLE_VERSION"
ARCHIVE="$CACHE_DIR/gradle-$GRADLE_VERSION-bin.zip"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
    mkdir -p "$CACHE_DIR"
    if [ ! -f "$ARCHIVE" ]; then
        curl \
            --fail \
            --location \
            --silent \
            --show-error \
            "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" \
            --output "$ARCHIVE"
    fi
    rm -rf "$GRADLE_HOME"
    unzip -q "$ARCHIVE" -d "$CACHE_DIR"
fi
exec "$GRADLE_HOME/bin/gradle" "$@"
